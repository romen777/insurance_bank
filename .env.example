# insurance_bank 자격증명 — 이 파일을 .env 로 복사해서 값을 채우십시오.
# .env 는 커밋되지 않습니다(.gitignore).

# Supabase 프로젝트 주소
SUPABASE_SIMSA_URL=https://<프로젝트>.supabase.co

# service 키(sb_secret_ 로 시작). Supabase → Project Settings → API keys
#  anon 키를 넣으면 RLS 에 막혀 **오류가 아니라 0건**이 옵니다.
#  "자료가 아직 없나 보다" 로 보이므로 반드시 service 키를 넣으십시오.
SUPABASE_SECRET_KEY=sb_secret_...
